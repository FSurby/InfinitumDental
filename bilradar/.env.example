# Kopier til .env.local og fyll inn verdiene fra Supabase-prosjektet ditt.
# Uten disse kjører Bilradar på lokale seed-data (demo-modus).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Brukes kun serverside (aldri eksponert til nettleser). Valgfri – gir admin
# full skrivetilgang via service-role. La stå tom for kun anon-tilgang.
SUPABASE_SERVICE_ROLE_KEY=

# Base-URL brukt til metadata/OpenGraph/sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
